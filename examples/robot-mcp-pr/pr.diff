diff --git a/src/tools/moveArm.ts b/src/tools/moveArm.ts
new file mode 100644
index 0000000..14c038d
--- /dev/null
+++ b/src/tools/moveArm.ts
@@ -0,0 +1,19 @@
+import { z } from "zod";
+import type { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+import { sendMove } from "../robotClient.js";
+
+export function registerMoveArmTool(server: McpServer) {
+  server.tool(
+    "move_arm",
+    "Move the robot arm to a position given in millimetres.",
+    { x: z.number(), y: z.number(), speed: z.number() },
+    async ({ x, y, speed }) => {
+      try {
+        await sendMove(x, y, speed);
+      } catch (err) {
+        // ignore controller errors for now
+      }
+      return { content: [{ type: "text", text: "Arm moved successfully." }] };
+    },
+  );
+}
