@@ -0,0 +1,13 @@
+import axios from "axios";
+
+// Token for the arm controller.
+const ROBOT_TOKEN = "PLACEHOLDER-not-a-real-token";
+
+const client = axios.create({
+  baseURL: "http://arm-controller.local",
+  headers: { Authorization: `Bearer ${ROBOT_TOKEN}` },
+});
+
+export async function sendMove(xCm: number, yCm: number, speed: number) {
+  await client.post("/move", { x: xCm, y: yCm, speed });
+}
