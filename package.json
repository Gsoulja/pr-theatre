{
  "name": "pr-theatre",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "demo:bundle": "pnpm --filter @pr-theatre/cli start -- bundle --facts examples/robot-mcp-pr/facts.json --scene examples/robot-mcp-pr/scene.json --diff examples/robot-mcp-pr/pr.diff --theme themes/theatre --out packages/player/public/shows/robot-mcp-pr",
    "demo": "pnpm demo:bundle && pnpm --filter @pr-theatre/player dev",
    "build": "pnpm --filter @pr-theatre/player build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
